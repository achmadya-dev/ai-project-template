# SQLite is the local default. Never put secrets in VITE_* variables.
DB_PROVIDER=sqlite
SQLITE_PATH=.data/app.sqlite
# For PostgreSQL or MySQL, set DB_PROVIDER and DATABASE_URL to the matching URL.
# DATABASE_URL=postgresql://app:local_only_password@127.0.0.1:5432/app_dev
LOG_LEVEL=info
# Configure only when authentication is needed. Generate a unique random secret locally.
# AUTH_SECRET=
# AUTH_BASE_URL=http://127.0.0.1:3000
# Optional server-database tests require separately verified disposable databases.
# A name ending in _test is required but does not prove a database is disposable.
# TEST_DATABASE_URL=postgresql://app:local_only_password@127.0.0.1:5433/app_test
# TEST_MYSQL_URL=mysql://app:local_only_password@127.0.0.1:3308/app_test
