{
  "name": "ai-project-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host 127.0.0.1",
    "build": "bunx --bun vite build",
    "start": "bun .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"*.{js,mjs,ts,json}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:policy": "node --test scripts/*.test.mjs",
    "check": "bun run format:check && bun run lint && bun run test:policy && bun run test && bun run build && bun run typecheck",
    "verify": "bun run check && bun run test:integration && bun run test:e2e && bun run test:production",
    "prepare": "husky",
    "db:migrate": "bun scripts/migrate.mjs",
    "task:new": "bun scripts/new-task.mjs",
    "doctor": "bun scripts/doctor.mjs",
    "test:production": "bun scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "2.1.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json}": "prettier --write"
  },
  "packageManager": "bun@1.4.2"
}
